[Unit]
Description=Beszel Agent Service
Wants=network-online.target
After=network-online.target

[Service]
Environment="PORT=45876"
Environment="KEY=beszel-ssh-key"
Environment="TOKEN=beszel-token"
Environment="HUB_URL=http://pi-server.internal:8090"
# Environment="EXTRA_FILESYSTEMS=sdb"
Environment="GPU_COLLECTOR=intel_gpu_top
Environment="PRIMARY_SENSOR=coretemp_package_id_0"
ExecStart=/opt/beszel-agent/beszel-agent
User=beszel
SupplementaryGroups=systemd-journal
Restart=on-failure
RestartSec=5
StateDirectory=beszel-agent
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_RAWIO CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_RAWIO CAP_SYS_ADMIN

# Security/sandboxing settings
KeyringMode=private
LockPersonality=yes
ProtectClock=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
PrivateTmp=yes
RemoveIPC=yes
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
