%%{
  init: {
    "fontFamily": "var(--md-text-font-family)", "themeCSS": "code { font-family: var(--md-code-font-family) !important; } .node.isp rect, .node.isp polygon, .node.isp circle, .node.isp path { fill: var(--isp-bg) !important; stroke: var(--isp-border) !important; stroke-width: 2px !important; } .node.multi rect, .node.multi polygon, .node.multi circle, .node.multi path { fill: var(--multi-bg) !important; stroke: var(--multi-border) !important; stroke-width: 2px !important; } .node.tenGb rect, .node.tenGb polygon, .node.tenGb circle, .node.tenGb path { fill: var(--tengb-bg) !important; stroke: var(--tengb-border) !important; stroke-width: 2px !important; } .node.twoFiveGb rect, .node.twoFiveGb polygon, .node.twoFiveGb circle, .node.twoFiveGb path { fill: var(--twofivegb-bg) !important; stroke: var(--twofivegb-border) !important; stroke-width: 2px !important; } .node.twoFiveGbTemp rect, .node.twoFiveGbTemp polygon, .node.twoFiveGbTemp circle, .node.twoFiveGbTemp path { fill: var(--twofivegb-bg) !important; stroke: var(--twofivegb-border) !important; stroke-width: 2px !important; stroke-dasharray: 5 5 !important; } .node.gigabit rect, .node.gigabit polygon, .node.gigabit circle, .node.gigabit path { fill: var(--gigabit-bg) !important; stroke: var(--gigabit-border) !important; stroke-width: 2px !important; } .node.gigabitTemp rect, .node.gigabitTemp polygon, .node.gigabitTemp circle, .node.gigabitTemp path { fill: var(--gigabit-bg) !important; stroke: var(--gigabit-border) !important; stroke-width: 2px !important; stroke-dasharray: 5 5 !important; } .node.wifi rect, .node.wifi polygon, .node.wifi circle, .node.wifi path { fill: var(--wifi-bg) !important; stroke: var(--wifi-border) !important; stroke-width: 2px !important; } .node.usb rect, .node.usb polygon, .node.usb circle, .node.usb path { fill: var(--usb-bg) !important; stroke: var(--usb-border) !important; stroke-width: 2px !important; } .nodeLabel { color: var(--node-text) !important; } .node text { fill: var(--node-text) !important; } .cluster rect { fill: var(--subgraph-bg) !important; stroke: var(--subgraph-border) !important; stroke-width: 1px !important; } .cluster-label text, .cluster text { fill: var(--node-text) !important; } .cluster-label span, .cluster span { color: var(--node-text) !important; } .edgeLabel, .edgeLabel span, .edgeLabel p, .labelBkg, .htmlLabel { background-color: var(--edge-bg) !important; color: var(--edge-text) !important; } .edgeLabel rect { fill: var(--edge-bg) !important; } .edgeLabel text { fill: var(--edge-text) !important; } .edgePath path, .flowchart-link { stroke: var(--edge-line) !important; } .marker path, .arrowheadPath { fill: var(--edge-line) !important; stroke: var(--edge-line) !important; }"
  }
}%%

flowchart-elk TD
    %% --- Dummy Class Definitions (To register the classes on the SVGs) ---
    classDef isp fill:, stroke:, padding:2.5em;
    classDef multi fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef tenGb fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef twoFiveGb fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef twoFiveGbTemp fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef gigabit fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef gigabitTemp fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef wifi fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef usb fill:, stroke:, rx:0.4rem, ry:0.4rem;
    
%% --- Nodes --- %%

    %% --- ISP --- %%
    ISP(("<svg xmlns='http://www.w3.org/2000/svg' width='48' height='48' viewBox='0 0 24 24' style='vertical-align: middle;' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-globe-icon lucide-globe'><circle cx='12' cy='12' r='10'/><path d='M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20'/><path d='M2 12h20'/></svg>")):::isp

    %% --- Living Room & Server Rack --- %%
    subgraph Living_Room ["Living Room</b>"]
        direction TB
        subgraph Server_Rack ["Server Rack</b>"]
            direction TB
            Modem["Hitron CODA56<br><i>(DOCSIS 3.1 Modem)</i>"]:::twoFiveGb
            RouterMain["ASUS RT-BE92U<br><i>(Router)</i>"]:::tenGb
            tenGbKeystone["Keystone Jack"]:::tenGb
            twoFiveGbKeystone["Keystone Jack"]:::twoFiveGb
            SwitchAgg["Ugreen Switch"]:::tenGb
            Zima["ZimaOS NAS<br><code>[192.168.50.4]</code><br><code>[192.168.50.5]</code>"]:::twoFiveGb
            VM["Debian Server<br><code>[192.168.50.6]</code>"]:::multi
        end
        subgraph TV_Stand ["TV Stand</b>"]
            SwitchTV["LiteWave Switch"]:::gigabit
            GoogleTV["Google TV Streamer"]:::gigabit
            SmartTV["TCL Smart TV"]:::gigabit
            Nintendo["Nintendo Switch"]:::gigabit
        end
    end

    %% --- Office & Printer Cart --- %%
    subgraph Office ["Office</b>"]
        direction TB
        subgraph PrinterCart ["Printer Cart</b>"]
            direction TB
            MeshNode["ASUS RT-AX55<br><i>(AiMesh Node)</i>"]:::gigabit
            SwitchOffice["TP-Link Switch"]:::gigabit
            Pi4["Pi 4B Server<br><code>[192.168.50.2]</code><br><code>[192.168.53.2]</code>"]:::gigabit
            PiZero["Pi Zero 2W Server<br><code>[192.168.50.3]</code>"]:::wifi
            BrLaser["Brother HL-L2300D"]:::usb
        end
        DesktopBen["Ben's Desktop<br><code>[192.168.50.10]</code>"]:::gigabit
        DesktopRob["Rob's Desktop"]:::gigabit
        Printer3D["Creality K1C<br><code>[192.168.50.15]</code>"]:::wifi
    end

    %% --- Mobile Devices --- %%
    subgraph Mobile ["Mobile Devices</b> <i>(VLAN50)</i>"]
        direction TB
        LaptopBen["Ben's Laptop"]:::wifi
        LaptopRob["Rob's Laptop"]:::twoFiveGb
        PhoneBen["Ben's Phone"]:::wifi
        PhoneRob["Rob's Phone"]:::wifi
    end

    %% --- IoT Network (VLAN53) --- %%
    subgraph IoT ["IoT Network</b> <i>(VLAN53)</i>"]
        direction TB
        IoTDevices["IoT Devices<br><code>[192.168.53.x]</code>"]:::wifi
    end

    %% --- Guest Wi-Fi (VLAN52) --- %%
    subgraph Guest ["Guest Network</b> <i>(VLAN52)</i>"]
        direction TB
        GuestDevices["Guest Devices<br><code>[192.168.52.x]</code>"]:::wifi
    end

%% --- Connections --- %%

    %% --- WAN & Uplinks --- %%
    ISP == "Coax Cable<br><i>(Black RG-11)</i>" ==> Modem
    Modem == "Port 2: 2.5 GbE<br><i>(Black Cat6a)</i>" ==> RouterMain

    %% --- Backhaul --- %%
    RouterMain == "Backhaul" ==> MeshNode

    %% --- Router to Switch --- %%
    RouterMain == "Port 1: 10 GbE<br><i>(Black Cat6a)</i>" ==> tenGbKeystone
    RouterMain == "Port 3: 2.5 GbE<br><i>(Black Cat6a)</i>" ==> twoFiveGbKeystone
    tenGbKeystone == "10Gb SFP+ Transceiver<br><i>(Red Cat6a)</i>" ==> SwitchAgg
    RouterMain == "Port 4<br><i>(White Cat6)</i>" ==> SwitchTV
    MeshNode == "Port 5<br><i>(Black Cat6a)</i>" ==> SwitchOffice

    %% --- Virtual Machines --- %%
    Zima -. "KVM / QEMU" .- VM

    %% --- Living Room --- %%
    SwitchAgg -- "Port 1<br><i>(White Cat5e)</i>" --> LaptopRob
    SwitchAgg -- "Port 4<br><i>(Blue Cat6a)</i>" --> Zima
    SwitchAgg -- "Port 5<br><i>(Yellow Cat6a)</i>" --> Zima
    SwitchTV -- "Port 2<br><i>(Black Cat6a)</i>" --> GoogleTV
    SwitchTV -- "Port 3<br><i>(Black Cat5e)</i>" --> SmartTV
    SwitchTV -- "Port 4<br><i>(Black Cat5e)</i>" --> Nintendo

    %% --- Office --- %%
    SwitchOffice -- "Port 1<br><i>(White Cat5e)</i>" --> DesktopBen
    SwitchOffice -- "Port 2<br><i>(White Cat5e)</i>" --> DesktopRob
    SwitchOffice -- "Port 3<br><i>(White Cat5e)</i>" --> Pi4
    Pi4 -. "USB" .- BrLaser

    %% --- Wi-Fi --- %%
    RouterMain -. "VLAN52" .- Guest
    RouterMain -. "VLAN53" .- IoT
    MeshNode -. "VLAN50" .- PiZero
    MeshNode -. "VLAN53<br><code>[wlan0]</code>" .- Pi4
    MeshNode -. "VLAN50" .- Printer3D
    RouterMain -. "VLAN50" .- Mobile