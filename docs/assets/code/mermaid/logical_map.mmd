    classDef storage fill:, stroke:;
    classDef usb-storage fill:, stroke:;
    classDef usb fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef os fill:, stroke:, rx:0.4rem, ry:0.4rem;

