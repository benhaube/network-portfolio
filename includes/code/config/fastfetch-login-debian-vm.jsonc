{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "bar": {
      "width": 10  // (1)!
    },
    "percent": {
      "type": 3,  // (2)!
       "color": {
         "green": "green",
         "yellow": "light_yellow",
         "red": "light_red"
      }
    },
    "key": {
      "type": "icon",  // (3)!
      "width": 5  // (4)!
    },
    "separator": " ↪",  // (5)!
    "color": {
      "separator": "light_red",
      "title": "white",
      "keys": "white"
    }
  },
  "modules": [
    "title",
    {
      "key": " ",
      "type": "datetime",
      "format": "{month-name-short} {day-pretty}, {year}: {hour-pretty}:{minute-pretty}:{second-pretty} {timezone-name}",
      "outputColor": "bright_red"
    },
    {
      "key": " ",
      "type": "custom",
      "format": "----------------------------"
    },
    "loadavg",
    "processes",
    "break",
    "os",
    {
      "type": "kernel",
      "format": "{2}"
    },
    "uptime",
    "packages",
    "break",
    {
      "type": "memory",
      "format": "{4}{3}: {1} / {2}"
    },
    {
      "type": "swap",
      "format": "{4}{3}: {1} / {2}"
    },
    {
      "type": "disk",
      "format": "{13}{3}: {10} - {1} / {2} - {9}"
    },
    "break",
    {
      "type": "localip",
      "key": "Local IP",
      "showMac": true,
      "showSpeed": true,
      "format": "{4} ({7}) - IPv4[{1}] MAC[{3}]"
    },
    {
      "type": "publicip",
      "timeout": 1000
    },
    {
      "type": "dns",
      "showType": "both"
    },
    "netio"
  ]
}
