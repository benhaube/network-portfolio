  init: {
    "fontFamily": "var(--md-text-font-family)", "themeCSS": "code { font-family: var(--md-code-font-family) !important; } .node.text-box rect, .node.text-box polygon, .node.text-box circle, .node.text-box path { fill: var(--md-mermaid-node-bg-color) !important; stroke: var(--md-mermaid-node-fg-color) !important; stroke-width: 2px !important; } .nodeLabel { color: var(--node-text) !important; } .node text { fill: var(--node-text) !important; } .cluster rect { fill: var(--subgraph-bg) !important; stroke: var(--subgraph-border) !important; stroke-width: 1px !important; } .cluster-label text, .cluster text { fill: var(--node-text) !important; } .cluster-label span, .cluster span { color: var(--node-text) !important; } .edgeLabel, .edgeLabel span, .edgeLabel p, .labelBkg, .htmlLabel { background-color: var(--edge-bg) !important; color: var(--edge-text) !important; } .edgeLabel rect { fill: var(--edge-bg) !important; } .edgeLabel text { fill: var(--edge-text) !important; } .edgePath path, .flowchart-link { stroke: var(--edge-line) !important; } .marker path, .arrowheadPath { fill: var(--edge-line) !important; stroke: var(--edge-line) !important; }"
  }
}%%

flowchart

    %% --- Dummy Class Definitions (To register the classes on the SVGs) ---
    classDef text-box fill:, stroke:, rx:0.4rem, ry:0.4rem;

    %% Phase 1
    subgraph Phase_1 ["<b>Phase 1:</b> Pre-Migration & Documentation"]
        direction TB
        Export["<b>Export Pi-hole Data:</b><br><br>Run a 'Teleporter' backup on your current primary and secondary Pi-holes."]:::text-box
        Document["<b>Document Static Records:</b><br><br>Note all local DNS records and DHCP reservations."]:::text-box
        Map["<b>Map IP Addresses</b>"]:::text-box
        Primary["<b>Primary:</b><br><br><i>(Debian Server)</i><br><code>192.168.50.6</code>"]:::text-box
        Secondary["<b>Secondary:</b><br><br><i>(Pi 4B Server)</i><br><code>192.168.50.2</code>"]:::text-box
        Tertiary["<b>Optional: Tertiary/Failover</b><br><br><i>(Pi Zero 2W Server)</i><br><code>192.168.50.3</code>"]:::text-box
    end
    
    %% Connections (Phase_1)
    Export --> Document
    Document --> Map
    Map --> Primary
    Map --> Secondary
    Map --> Tertiary
    Phase_1 ==> Phase_2
    
    %% Phase 2
    subgraph Phase_2 ["<b>Phase 2:</b> Server Provisioning"]
        direction TB
        subgraph Debian_VM ["<b>Debian Server</b> <i>(VM @ ZimaOS NAS)</i>"]
            direction TB
            Allocate["<b>Allocate Resources:</b><br><br>Assign 2 vCPUs and 2GB RAM to the VM."]:::text-box
            Install["<b>Install Technitium:</b><br><br>Use the installer script or Docker container."]:::text-box
            Configure["<b>Set Upstream Servers:</b><br><br>Set Quad9 DoT<br><code>9.9.9.9:853</code><br><code>149.112.112.112:853</code>"]:::text-box
            Import["<b>Import Records:</b><br><br>Manually add local DNS zones/records from the Pi-hole export."]:::text-box
        end
        subgraph RasPi_4B ["<b>Pi 4B Server</b>"]
            direction TB
            Install_Pi["<b>Install Technitium:</b><br><br>Match the version running on <b>Debian Server</b>."]:::text-box
            Set_Secondary["<b>Set as Secondary:</b><br><br>Configure identical upstream servers."]:::text-box
        end   
    end
    
    %% Connections (Phase_2)
    Allocate --> Install
    Install --> Configure
    Configure --> Import
    
    Install_Pi --> Set_Secondary
    Phase_2 ==> Phase_3
    
    %% Phase 3
    subgraph Phase_3 ["<b>Phase 3:</b> Cluster Synchronization"]
        direction TB
        Enable_Clustering["<b>Enable Clustering</b>"]:::text-box
        DebianVM_Master["Set <b>Debian Server</b> as the <b>Master</b>."]:::text-box
        Pi4B_Slave["Set <b>Pi 4B Server</b> as the <b>Slave</b>."]:::text-box
        Verify_Sync["<b>Verify Sync:</b><br><br>Ensure local zones and blocklists are appearing on both instances."]:::text-box
        Tuning["<b>Blocklist Tuning:</b><br><br>Add your preferred lists <i>(e.g., OISD, HaGeZi)</i> and verify they are enabled on both."]:::text-box
    end
    
    %% Connections (Phase_3)
    Enable_Clustering --> DebianVM_Master
    Enable_Clustering --> Pi4B_Slave
    DebianVM_Master --> Verify_Sync
    Pi4B_Slave --> Verify_Sync
    Verify_Sync --> Tuning
    Phase_3 ==> Phase_4
    
    subgraph Phase_4 ["<b>Phase 4:</b> Network Cutover"]
        direction TB
        DHCP["<b>Update Router DHCP</b>"]:::text-box
        DHCP_1["Point DNS #1 to <b>Debian Server</b> IP address."]:::text-box
        DHCP_2["Point DNS #2 to <b>Pi 4B Server</b> IP address."]:::text-box
        DHCP_3["<b>Optional:</b> Point DNS #3 to <b>Pi Zero 2W Server</b> IP address."]:::text-box
        Clear_Cache["<b>Clear Local Caches:</b><br><br>Flush DNS on your main workstation.<br><br>'<code>resolvectl flush-caches</code>' or '<code>ipconfig /flushdns</code>'"]:::text-box
        Test_Resolution["<b>Test Resolution:</b><br><br>Run '<code>dig @[Primary-IP] google.com</code>' and verify the <code>[SERVER]</code> field."]:::text-box
    end
    
    %% Connections (Phase_4)
    DHCP --> DHCP_1
    DHCP --> DHCP_2
    DHCP --> DHCP_3
    DHCP_1 --> Clear_Cache
    DHCP_2 --> Clear_Cache
    Clear_Cache --> Test_Resolution
    Phase_4 ==> Phase_5
    
    subgraph Phase_5 ["<b>Phase 5:</b> Verification & Safety Net"]
        direction TB
        DoT_Status["<b>Check DoT Status:</b><br><br>Ensure upstream is encrypted.<br>'<code>dig @[Primary-IP] +short txt proto.on.quad9.net</code>'"]:::text-box
        Fallback["<b>Optional: Verify Pi Zero Fallback</b><br><br>Temporarily stop the Technitium service on both <b>Debian Server</b> and <b>Pi 4B Server</b>.<br><br>Confirm the <b>Pi Zero 2W Server</b> takes over resolution."]:::text-box
        Audit["<b>Audit Dashboard:</b><br><br>Monitor the Technitium dashboard for any unexpected <code>NXDOMAIN</code> responses or high latency."]:::text-box
    end
    
    %% Connections (Phase_5)
    DoT_Status --> Fallback
    Fallback --> Audit