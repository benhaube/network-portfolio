%%{
  init: {
    "fontFamily": "var(--md-text-font-family)", "themeCSS": "code { font-family: var(--md-code-font-family) !important; } .node.vlan50 rect, .node.vlan50 polygon, .node.vlan50 circle, .node.vlan50 path { fill: var(--vlan50-bg) !important; stroke: var(--vlan50-border) !important; stroke-width: 2px !important; } .node.vlan52 rect, .node.vlan52 polygon, .node.vlan52 circle, .node.vlan52 path { fill: var(--vlan52-bg) !important; stroke: var(--vlan52-border) !important; stroke-width: 2px !important } .node.vlan53 rect, .node.vlan53 polygon, .node.vlan53 circle, .node.vlan53 path { fill: var(--vlan53-bg) !important; stroke: var(--vlan53-border) !important; stroke-width: 2px !important; } .node.service rect, .node.service polygon, .node.service circle, .node.service path { fill: var(--service-bg) !important; stroke: var(--service-border) !important; stroke-width: 2px !important; } .node.storage rect, .node.storage polygon, .node.storage circle, .node.storage path { fill: var(--storage-bg) !important; stroke: var(--storage-border) !important; stroke-width: 2px !important; } .node.usb-storage rect, .node.usb-storage polygon, .node.usb-storage circle, .node.usb-storage path { fill: var(--storage-bg) !important; stroke: var(--storage-border) !important; stroke-width: 2px !important; stroke-dasharray: 5 5 !important; } .node.usb rect, .node.usb polygon, .node.usb circle, .node.usb path { fill: var(--usb-bg) !important; stroke: var(--usb-border) !important; stroke-width: 2px !important; } .node.os rect, .node.os polygon, .node.os circle, .node.os path { fill: var(--os-bg) !important; stroke: var(--os-border) !important; stroke-width: 2px !important; } .nodeLabel { color: var(--node-text) !important; } .node text { fill: var(--node-text) !important; } .cluster rect { fill: var(--subgraph-bg) !important; stroke: var(--subgraph-border) !important; stroke-width: 1px !important; } .cluster-label text, .cluster text { fill: var(--node-text) !important; } .cluster-label span, .cluster span { color: var(--node-text) !important; } .edgeLabel, .edgeLabel span, .edgeLabel p, .labelBkg, .htmlLabel { background-color: var(--edge-bg) !important; color: var(--edge-text) !important; } .edgeLabel rect { fill: var(--edge-bg) !important; } .edgeLabel text { fill: var(--edge-text) !important; } .edgePath path, .flowchart-link { stroke: var(--edge-line) !important; } .marker path, .arrowheadPath { fill: var(--edge-line) !important; stroke: var(--edge-line) !important; }"
  }
}%%

flowchart-elk TD
    %% --- Dummy Class Definitions (To register the classes on the SVGs) --- %%
    classDef vlan50 fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef vlan52 fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef vlan53 fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef service fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef storage fill:, stroke:;
    classDef usb-storage fill:, stroke:;
    classDef usb fill:, stroke:, rx:0.4rem, ry:0.4rem;
    classDef os fill:, stroke:, rx:0.4rem, ry:0.4rem;

%% --- Nodes --- %%

    %% --- Main Router --- %%
    subgraph Router ["ASUS RT-BE92U <i>(Main Router)</i>"]
        direction TB
        Asuswrt_Merlin["Firmware:<br>Asuswrt-Merlin"]:::os
        Services["Services"]:::service
        Router_USB[("sda1<br><i>(28.3 GB / USB)</i>")]:::storage
        Router_Swap[("Swap<br><i>(2 GB)</i>")]:::storage
        Router_JFFS[("JFFS<br><i>(45 MB)</i>")]:::storage
        RouterNVRAM[("NVRAM<br><i>(256 KB)</i>")]:::storage
    end

    %% --- AiMesh Node --- %%
    subgraph AiMesh_Node["ASUS RT-AX55 <i>(Mesh Node)</i>"]
        direction TB
        Asuswrt["Firmware:<br>Asuswrt"]:::os
        AiMesh_JFFS[("JFFS")]:::storage
        AiMesh_NVRAM[("NVRAM")]:::storage
    end

    %% --- Trusted VLAN --- %%
    subgraph Trusted_VLAN50 ["VLAN50: Trusted <code>[192.168.50.x]</code>"]
        direction TB
        
        Clients["<div style='text-align: center;'>Trusted Clients:</div><ul style='text-align: left; display: inline-block; margin: 0 auto;'><li>Desktop PCs</li><li>Laptop PCs</li><li>Smartphones</li><li>Other...</li></ul>"]:::vlan50
        Printer["Creality K1C<br><i>(3D-printer)</i>"]:::vlan50
        Brother["Brother HL-L2300D<br><i>(Laser Printer)</i>"]:::usb
        USB_Ext[("sda1<br><i>(32 GB / USB)</i>")]:::storage

        %% --- ZimaOS NAS --- %%
        subgraph Server_Zima ["ZimaOS NAS <code>[.4 / .5]</code>"]
            Storage_SMB[("Quick-Storage<br><i>(2 TB / RAID1)</i>")]:::storage
            Storage_NVMe[("nvme0n1p1<br><i>(500 GB / NVMe)</i>")]:::storage
            Storage_MMC[("ZimaOS-HD<br><i>(64 GB / eMMC)</i>")]:::storage
            ZimaOS["Operating System:<br>ZimaOS v1.7.0"]:::os
            Service_Docker["Docker Containers"]:::service
            Syncthing_Zima["Syncthing"]:::service
            
            %% --- Debain VM Server --- %%
            subgraph VM_Debian ["Debian Server <code>[.6]</code>"]
                DNS_Primary["Primary DNS Server<br><i>(Technitium)</i>"]:::service
                Syncthing_VM["Syncthing"]:::service
                Service_Docker_VM["Docker Containers"]:::service
                OS_DebianVM["Operating System:<br>Debian 13 <i>(trixie)</i>"]:::os
                Virtual_Disk[("sda2<br><i>(50 GB / VDI)</i>")]:::storage
            end
        end

        %% --- Pi 4B Server --- %%
        subgraph Server_Pi4 ["Pi 4B Server <code>[.2]</code>"]
            MicroSD_Pi4[("mmcblk0p2<br><i>(128 GB / MicroSD)</i>")]:::storage
            OS_Pi4["Operating System:<br>Debian 13 <i>(trixie)</i>"]:::os
            DNS_Secondary["Secondary DNS Server<br><i>(Technitium)</i>"]:::service
            HA["Home Assistant<br><i>(Docker)</i>"]:::service
            Print["CUPS Print Server"]:::service
            Syncthing_Pi4["Syncthing"]:::service
            Service_Docker_Pi4["Docker Containers"]:::service
        end

        %% --- Pi Zero 2W Server --- %%
        subgraph Server_PiZero ["Pi Zero 2W Server <code>[.3]</code>"]
            MicroSD_PiZero[("mmcblk0p2<br><i>(64 GB / MicroSD)</i>")]:::storage
            OS_PiZero["Operating System:<br>Debian 13 <i>(trixie)</i>"]:::os
            Service_Docker_PiZero["Docker Containers"]:::service
            Syncthing_PiZero["Syncthing"]:::service
            Caddy["Caddy Reverse Proxy<br><i>(Unique FQDN for services)</i>"]:::service
        end
    end

    %% --- IoT VLAN --- %%
    subgraph IoT_VLAN53 ["VLAN53: IoT <code>[192.168.53.x]</code>"]
        direction TB
        IoTClients["IoT Clients"]:::vlan53  
    end

    %% --- Guest VLAN --- %%
    subgraph Guest_VLAN52 ["VLAN52: Guest <code>[192.168.52.x]</code>"]
        direction TB
        GuestClients["Guest Clients"]:::vlan52
    end
    
%% --- Connections --- %%

    %% --- Main Router storage connections --- %%
    Asuswrt_Merlin -- "Settings" --> RouterNVRAM
    Asuswrt_Merlin -- "Scripts / Logs" --> Router_JFFS
    Asuswrt_Merlin -- "Scripts / Logs" --> Router_USB
    Asuswrt_Merlin -- "RAM Swap" --> Router_Swap
    Services -- "Storage" --> Router_USB
    Services -- "Storage" --> Router_JFFS
    Router_USB -- "Partition" --> Router_Swap

    %% --- AiMesh Node Connections --- %%
    Asuswrt -- "Settings" --> AiMesh_NVRAM
    Asuswrt -- "Storage / Logs" --> AiMesh_JFFS
    Router == "Backhaul" ==> AiMesh_Node

    %% --- Debian VM storage connections --- %%
    DNS_Primary -- "Storage" --> Virtual_Disk
    Syncthing_VM -- "Storage" --> Virtual_Disk
    Service_Docker_VM -- "Storage" --> Virtual_Disk
    OS_DebianVM -- "Storage" --> Virtual_Disk

    %% --- ZimaOS NAS storage connections --- %%
    Virtual_Disk  -- "Storage" --> Storage_NVMe
    Service_Docker -- "Storage" --> Storage_NVMe
    Service_Docker -- "Immich Library" --> Storage_SMB
    Syncthing_Zima -- "Storage" --> Storage_NVMe
    Syncthing_Zima -- "Storage" --> Storage_SMB
    ZimaOS -- "Storage" --> Storage_MMC

    %% --- Pi 4B storage connections --- %%
    DNS_Secondary -- "Storage" --> MicroSD_Pi4
    OS_Pi4 -- "Storage" --> MicroSD_Pi4
    HA -- "Storage" --> MicroSD_Pi4
    Service_Docker_Pi4 -- "Storage" --> MicroSD_Pi4
    Print -- "Storage" --> MicroSD_Pi4
    Syncthing_Pi4 -- "Storage" --> MicroSD_Pi4
    Server_Pi4 -. "USB Storage" .- USB_Ext

    %% --- Pi Zero storage connections --- %%
    Service_Docker_PiZero -- "Storage" --> MicroSD_PiZero
    Caddy -- "Storage" --> MicroSD_PiZero
    Syncthing_PiZero -- "Storage" --> MicroSD_PiZero
    OS_PiZero -- "Storage" --> MicroSD_PiZero

    %% --- Trusted VLAN Connections --- %%
    Clients -- "DNS Query" --> DNS_Primary
    Clients -- "DNS Query" --> DNS_Secondary
    Clients -- "HTTPS" --> Caddy
    Caddy -- "DNS Query" --> DNS_Primary
    Caddy -- "DNS Query" --> DNS_Secondary
    IoT_VLAN53 -. "Device Control<br><code>wlan0</code>" .- HA
    Clients -- "SMB / NFS / Backups" --> Storage_SMB
    Clients -- "Photo Backup<br><i>(Immich)</i>" --> Storage_SMB
    Clients -- "Manage" --> HA
    Clients -- "Manage" --> Printer
    Clients -- "Print" --> Print
    Printer -- "Status / Video" --> HA
    Print -. "USB Printer" .- Brother
 
    %% --- Router --> VLAN Connections --- %%
    Router -- "VLAN50" --> Trusted_VLAN50
    Router -- "VLAN52" --> Guest_VLAN52
    Router -- "VLAN53" --> IoT_VLAN53
    AiMesh_Node -- "VLAN50" --> Trusted_VLAN50