[Unit]
Description=Weekday client data backup to Backblaze B2
After=network-online.target

[Service]
Type=oneshot
ExecStartPre=-curl -sS -m 10 --retry 5 https://healthchecks.rac3r4life.online/ping/{UUID}/zimaos-nas-devices-backup/start
ExecStart=/opt/scripts/b2-backup-bkp.sh
ExecStopPost=curl -sS -m 10 --retry 5 https://healthchecks.rac3r4life.online/ping/{UUID}/zimaos-nas-devices-backup/${EXIT_STATUS}

[Install]
WantedBy=multi-user.target
