            MicroSD_Pi4[("<b>MicroSD Storage</b><br><i>(128 GB)</i>")]:::storage
            OS_Pi4["<b>Operating System:</b><br>Debian 13 <i>(trixie)</i>"]:::os
            DNS_Secondary["<b>Secondary DNS</b><br><i>(Technitium Cluster)</i>"]:::service
            HA["Home Assistant"]:::service
