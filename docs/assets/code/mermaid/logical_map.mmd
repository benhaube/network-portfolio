    %% --- IoT VLAN --- %%
    subgraph IoT_VLAN53 ["<svg class="lucide lucide-network-icon lucide-network" width="24" height="24" fill="none" style="vertical-align: middle;" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" version="1.1" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m17 16h4c.554 0 1 .446 1 1v4c0 .554-.446 1-1 1h-4c-.554 0-1-.446-1-1v-4c0-.554.446-1 1-1z"/><path d="m3 16h4c.554 0 1 .446 1 1v4c0 .554-.446 1-1 1h-4c-.554 0-1-.446-1-1v-4c0-.554.446-1 1-1z"/><path d="m10 2h4c.554 0 1 .446 1 1v4c0 .554-.446 1-1 1h-4c-.554 0-1-.446-1-1v-4c0-.554.446-1 1-1z"/><path d="m5 16v-3a1 1 0 011-1h12a1 1 0 011 1v3"/><path d="M12 12V8"/></svg>&emsp;<b>VLAN53:</b> IoT <code>[192.168.53.x]</code>"]
