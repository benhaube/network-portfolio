# General Authentik variables
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.8.5
AUTHENTIK_SECRET_KEY=your-secret-key
AUTHENTIK_ERROR_REPORTING__ENABLED=true
# Authentik server ports
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
# SMTP email configuration
AUTHENTIK_EMAIL__HOST=smtp.fastmail.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=benhaube@fastmail.com
AUTHENTIK_EMAIL__PASSWORD=email-app-pw
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=authentik@haube-pereira.com
# Postgres database
PG_DB=authentik
PG_USER=authentik
PG_PASS=posgress-pw
