{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/opt/share/fastfetch/logos/zimaos.txt",
    "color": {
        "1": "#FFAA00",
        "2": "white"
    }
  },  
  "display": {
    "bar": {
      "width": 10  // (1)!
    },
    "percent": {
      "type": 3,  // (2)!
       "color": {
         "green": "green",
         "yellow": "light_yellow",
         "red": "light_red"
      }
    },
    "key": {
      "type": "icon",  // (3)!
      "width": 5  // (4)!
    },
    "separator": " ↪",  // (5)!
    "color": {
      "separator": "#FFAA00",
      "title": "#FFAA00",
      "keys": "white"
    }
  },
  "modules": [
    "title",
    {
      "key": " ",
      "type": "datetime",
      "format": "{month-name-short} {day-pretty}, {year}: {hour-pretty}:{minute-pretty}:{second-pretty} {timezone-name}",
      "outputColor": "#FFAA00"
    },
    { 
      "key": " ",
      "type": "custom",
      "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    },
   "loadavg",
    "processes",
    "break",
    "os",
    {
      "type": "kernel",
      "format": "{2}"
    },
    "uptime",
    "packages",
    "break",
    {
      "type": "memory",
      "format": "{4}{3}: {1} / {2}"
    },
    {
      "type": "swap",
      "format": "{4}{3}: {1} / {2}"
    },
    {
      "type": "disk",
      "format": "{13}{3}: {1} / {2} - {20} - {9}",
      "folders": "/media/nvme0n1p1:/media/Quick-Storage"
    },
    "break",
    {
      "type": "localip",
      "key": "Primary IP",
      "namePrefix": "eth0",
      "defaultRouteOnly": false,
      "showMac": true,
      "showSpeed": true,
      "format": "{4} ({7}) - IPv4[{1}] MAC[{3}]"
    },
    {
      "type": "localip",
      "key": "Secondary IP",
      "namePrefix": "eth1",
      "defaultRouteOnly": false,
      "showMac": true,
      "showSpeed": true,
      "format": "{4} ({7}) - IPv4[{1}] MAC[{3}]"
    },
    {
      "type": "publicip",
      // "showAllIps": true,
      "timeout": 1000
    },
    {
      "type": "dns",
      "showType": "both"
    },
    "netio"
  ]
}
